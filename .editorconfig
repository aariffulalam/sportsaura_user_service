# Basic editor rules shared by every editor (VS Code, IntelliJ, ...).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
max_line_length = 100

[*.{sql,xml}]
indent_size = 4

[pom.xml]
indent_style = tab

[*.cmd]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
