# Sample environment file.
# Copy this file to ".env" and change the values. Never commit ".env".
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env

# ---- Server ---------------------------------------------------------------
# Port the user service listens on.
SERVER_PORT=8081

# ---- Database (MySQL) -----------------------------------------------------
# Host and port the app uses to reach MySQL when you run it on your machine.
# docker-compose.yml publishes MySQL on DB_PORT, and overrides these two for
# the app container (inside Docker it uses user-db:3306).
DB_HOST=localhost
DB_PORT=3307
DB_NAME=sportsaura_user
DB_USERNAME=sportsaura
DB_PASSWORD=change-me-app-password
# Password of the MySQL root user. Only used by docker-compose to create the database.
DB_ROOT_PASSWORD=change-me-root-password

# ---- JWT (login tokens) ---------------------------------------------------
# Secret used to sign tokens. Must be at least 32 characters, random, and
# different in every environment. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-characters
# How long an access token stays valid. Keep it short; apps get a new one with the refresh token.
JWT_EXPIRATION_MINUTES=15
# How long a refresh token stays valid. After this the user must log in again.
REFRESH_TOKEN_EXPIRATION_DAYS=30
